{
  "name": "ikiway-pos-printer-agent",
  "version": "2.1.4",
  "description": "Agente de impresión ESC/POS USB para Ikiway Commerce",
  "author": "Ikiway",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.mjs",
    "desktop": "npm run generate:icon && electron .",
    "generate:icon": "node scripts/generate-icon.mjs",
    "pack:win": "npm run generate:icon && electron-builder --win --x64 --dir",
    "dist:win": "npm run generate:icon && electron-builder --win --x64 --publish never",
    "test": "node --test",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.8.9",
    "express": "^5.2.1",
    "iconv-lite": "^0.6.3",
    "pngjs": "^7.0.0",
    "qs": "^6.16.0",
    "usb": "^2.16.0"
  },
  "devDependencies": {
    "electron": "36.9.5",
    "electron-builder": "^26.15.3"
  }
}
